{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fruity Studio",
  "version": "0.1.0",
  "identifier": "com.fruitystudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fruity Studio",
        "width": 1480,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#15111d",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "object-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Video",
    "shortDescription": "Studio de production de vidéos de personnages fruits",
    "longDescription": "Fruity Studio : bibliothèque de personnages, génération d'histoires avec Gemini, prompts Google Flow et assemblage vidéo TikTok avec FFmpeg.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
